{
    "package_version": 2,
    "version": "1.0.0",
    "name": "oops-plugin-excel-to-json",
    "description": "i18n:oops-plugin-excel-to-json.description",
    "main": "./dist/src/index.js",
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "fs-extra": "^10.0.0",
        "iconv-lite": "^0.7.0",
        "jsonwebtoken": "^9.0.3",
        "mysql": "^2.18.1",
        "ts-node": "^10.9.2",
        "typescript": "^4.8.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^9.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mysql": "^2.15.27",
        "@types/node": "^16.0.1"
    },
    "scripts": {
        "build": "tsc -b",
        "watch": "tsc -w",
        "tsnode": "ts-node src/ExcelToJson.ts",
        "build:server": "tsc -p code/server/tsconfig.json",
        "start:server": "node dist/code/server/src/index.js",
        "dev:server": "ts-node code/server/src/index.ts",
        "dev:client": "cd code/client && npm run dev",
        "build:client": "cd code/client && npm run build"
    }
}
